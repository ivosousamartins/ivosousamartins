{
  "buildCommand": "cd site && npm install && npm run build",
  "outputDirectory": "site/dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/privacy.html",
      "destination": "/privacy/",
      "permanent": true
    },
    {
      "source": "/pt/privacy.html",
      "destination": "/pt/privacy/",
      "permanent": true
    },
    {
      "source": "/es/privacy.html",
      "destination": "/es/privacy/",
      "permanent": true
    },
    {
      "source": "/pt/index.html",
      "destination": "/pt/",
      "permanent": true
    },
    {
      "source": "/es/index.html",
      "destination": "/es/",
      "permanent": true
    },
    {
      "source": "/assets/og-image.jpg",
      "destination": "/og-image.jpg",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
