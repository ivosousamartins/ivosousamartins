---
// iPhone 17 Pro with Instagram UI. Everything inside is sized in em off the phone's own width,
// so the size class (post, reel, big) is the only thing that changes it.
interface Props {
  img: string;
  mode?: 'post' | 'reel';
  size?: 'post' | 'reel' | 'big';
  handle: string;
  avatar?: string;
  caption?: string;
  ratio?: string;
  finish?: 'silver' | 'deep blue' | 'cosmic orange';
  slides?: string[];
  alt?: string;
}
const { img, mode = 'post', size, handle, avatar, caption = '', ratio = '4 / 5', finish = 'silver', slides, alt = '' } = Astro.props;
const FINISH: Record<string, [string, string]> = {
  silver: ['#e3e4e6', '#b9bbbf'],
  'deep blue': ['#3b4a63', '#1f2a3c'],
  'cosmic orange': ['#f08a4b', '#c25a22'],
};
const [frameA, frameB] = FINISH[finish] ?? FINISH.silver;
const reel = mode === 'reel';
const ink = reel ? '#fff' : '#000';
const list = slides && slides.length > 1 ? slides : null;
const cls = `phone ${size ?? (reel ? 'reel' : 'post')}`;
---
<div class={cls}>
  <div class="ig" style={`--fa:${frameA};--fb:${frameB};--ink:${ink};--scr:${reel ? '#000' : '#fff'}`}>
    <div class="ig-bezel"><div class="ig-screen">
      <div class="ig-island"></div>
      <div class="ig-status">
        <span style="font-size:1.15em">9:41</span>
        <span class="ig-icons">
          <svg aria-hidden="true" width="1.3em" height="0.9em" viewBox="0 0 18 12"><rect x="0" y="8" width="3" height="4" rx="1" fill="currentColor"/><rect x="5" y="5.5" width="3" height="6.5" rx="1" fill="currentColor"/><rect x="10" y="3" width="3" height="9" rx="1" fill="currentColor"/><rect x="15" y="0" width="3" height="12" rx="1" fill="currentColor"/></svg>
          <svg aria-hidden="true" width="2em" height="0.95em" viewBox="0 0 26 12"><rect x=".5" y=".5" width="22" height="11" rx="3.5" fill="none" stroke="currentColor" opacity=".45"/><rect x="2" y="2" width="17" height="8" rx="2" fill="currentColor"/><rect x="23.5" y="4" width="1.8" height="4" rx=".9" fill="currentColor" opacity=".45"/></svg>
        </span>
      </div>

      {!reel && (
        <>
          <div class="ig-head">
            <span class="ig-ring"><span>{avatar && <img src={avatar} alt="" loading="lazy" />}</span></span>
            <span class="ig-handle">{handle}</span>
            <span class="ig-dots">···</span>
          </div>
          <div class="ig-media" style={`aspect-ratio:${ratio}`}>
            {list ? (
              <div class="ig-carousel" data-carousel>
                <div class="ig-track">
                  {list.map((src, k) => <img src={src} alt={k === 0 ? alt : ''} draggable="false" loading="lazy" decoding="async" />)}
                </div>
                <span class="ig-count" data-count>1/{list.length}</span>
                <button type="button" class="ig-arrow prev" aria-label="Previous slide" data-prev hidden><svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3.5L5.5 8l4.5 4.5"/></svg></button>
                <button type="button" class="ig-arrow next" aria-label="Next slide" data-next><svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3.5L10.5 8 6 12.5"/></svg></button>
              </div>
            ) : (
              <img src={img} alt={alt} draggable="false" loading="lazy" decoding="async" />
            )}
          </div>
          <div class="ig-actions">
            {list && <span class="ig-pager" data-dots>{list.map((_, k) => <i class={k === 0 ? 'on' : ''}></i>)}</span>}
            <svg aria-hidden="true" width="1.9em" height="1.9em" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="1.9"><path d="M12 20.5s-7.5-4.6-9.2-9.3C1.6 7.8 3.9 4.5 7.3 4.5c2 0 3.6 1.1 4.7 2.7 1.1-1.6 2.7-2.7 4.7-2.7 3.4 0 5.7 3.3 4.5 6.7-1.7 4.7-9.2 9.3-9.2 9.3z"/></svg>
            <svg aria-hidden="true" width="1.85em" height="1.85em" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="1.9"><path d="M20.6 15.6A9 9 0 1 0 17 19.5L21 21l-.4-5.4z"/></svg>
            <svg aria-hidden="true" width="1.8em" height="1.8em" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="1.9" stroke-linejoin="round"><path d="M22 3 2 10.5l7.5 3L12 21l3.2-7.7L22 3zM9.5 13.5 22 3"/></svg>
            <span style="flex:1"></span>
            <svg aria-hidden="true" width="1.75em" height="1.75em" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="1.9" stroke-linejoin="round"><path d="M5.5 3h13v18l-6.5-5-6.5 5z"/></svg>
          </div>
          <p class="ig-caption"><strong>{handle}</strong> {caption}</p>
          <span style="flex:1"></span>
        </>
      )}

      {reel && (
        <>
          <div class="ig-reelbg"><img src={img} alt={alt} loading="lazy" decoding="async" /></div>
          <p class="ig-reels">Reels</p>
          <span style="flex:1"></span>
          <div class="ig-side">
            <svg aria-hidden="true" width="2em" height="2em" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.9"><path d="M12 20.5s-7.5-4.6-9.2-9.3C1.6 7.8 3.9 4.5 7.3 4.5c2 0 3.6 1.1 4.7 2.7 1.1-1.6 2.7-2.7 4.7-2.7 3.4 0 5.7 3.3 4.5 6.7-1.7 4.7-9.2 9.3-9.2 9.3z"/></svg>
            <svg aria-hidden="true" width="1.9em" height="1.9em" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.9"><path d="M20.6 15.6A9 9 0 1 0 17 19.5L21 21l-.4-5.4z"/></svg>
            <svg aria-hidden="true" width="1.85em" height="1.85em" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.9" stroke-linejoin="round"><path d="M22 3 2 10.5l7.5 3L12 21l3.2-7.7L22 3zM9.5 13.5 22 3"/></svg>
            <span style="font-weight:700;letter-spacing:.1em">···</span>
          </div>
          <div class="ig-reelinfo">
            <p class="ig-who"><span>{avatar && <img src={avatar} alt="" loading="lazy" />}</span>{handle}</p>
            <p class="ig-reelcap">{caption}</p>
          </div>
        </>
      )}

      <div class="ig-nav">
        <svg aria-hidden="true" width="1.9em" height="1.9em" viewBox="0 0 24 24" fill="none" stroke={ink} stroke-width="1.9" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5V21h-6v-6H9v6H3z"/></svg>
        <svg aria-hidden="true" width="1.9em" height="1.9em" viewBox="0 0 24 24" fill="none" stroke={ink} stroke-width="1.9"><circle cx="10.5" cy="10.5" r="7"/><path d="m16 16 5 5"/></svg>
        <svg aria-hidden="true" width="1.9em" height="1.9em" viewBox="0 0 24 24" fill="none" stroke={ink} stroke-width="1.9" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><path d="M3 8h18M8 3l3 5M14 3l3 5M10 11.5v6l5-3z"/></svg>
        <svg aria-hidden="true" width="1.9em" height="1.9em" viewBox="0 0 24 24" fill="none" stroke={ink} stroke-width="1.9" stroke-linejoin="round"><path d="M22 3 2 10.5l7.5 3L12 21l3.2-7.7L22 3z"/></svg>
        <span class="ig-me"></span>
      </div>
      <div class="ig-home"></div>
    </div></div>
  </div>
</div>

<style is:global>
  .ig { font-size: calc(100cqw / 29); aspect-ratio: 9 / 19.5; padding: 0.42em; border-radius: 4.1em; background: linear-gradient(145deg, var(--fa), var(--fb)); box-shadow: inset 0 0 0 0.12em rgba(255,255,255,.35), 0 1.8em 4em rgba(0,0,0,.28); font-family: Inter, -apple-system, Arial, sans-serif; color: #000; line-height: 1.35; }
  .ig-bezel { position: relative; width: 100%; height: 100%; border-radius: 3.7em; background: #000; padding: 0.38em; overflow: hidden; }
  .ig-screen { position: relative; width: 100%; height: 100%; border-radius: 3.35em; overflow: hidden; background: var(--scr); display: flex; flex-direction: column; }
  .ig-island { position: absolute; left: 50%; top: 0.9em; transform: translateX(-50%); width: 7.4em; height: 2.1em; border-radius: 2em; background: #000; z-index: 3; }
  .ig-status { flex: none; height: 4.4em; display: flex; align-items: center; justify-content: space-between; padding: 0 2.4em 0 2.8em; font-weight: 600; color: var(--ink); z-index: 2; }
  .ig-icons { display: flex; gap: 0.35em; align-items: center; }
  .ig-head { flex: none; display: flex; align-items: center; gap: 0.7em; padding: 0.6em 1.1em; }
  .ig-ring { width: 2.5em; height: 2.5em; border-radius: 50%; padding: 0.14em; background: conic-gradient(#feda75, #fa7e1e, #d62976, #962fbf, #4f5bd5, #feda75); display: grid; place-items: center; }
  .ig-ring > span { width: 100%; height: 100%; border-radius: 50%; background: #fff; border: 0.14em solid #fff; overflow: hidden; display: grid; place-items: center; }
  .ig-ring img, .ig-who img { width: 80%; height: 80%; object-fit: contain; filter: brightness(0); }
  .ig-handle { font-weight: 600; font-size: 1.05em; flex: 1; }
  .ig-dots { font-weight: 700; letter-spacing: 0.1em; }
  .ig-media { position: relative; flex: none; width: 100%; }
  .ig-media > img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ig-carousel, .ig-track { width: 100%; height: 100%; }
  .ig-track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; cursor: grab; touch-action: pan-x pan-y; }
  .ig-track::-webkit-scrollbar { display: none; }
  .ig-track.drag { scroll-snap-type: none; cursor: grabbing; }
  .ig-track img { flex: none; width: 100%; height: 100%; object-fit: cover; display: block; scroll-snap-align: start; user-select: none; -webkit-user-drag: none; }
  .ig-count { position: absolute; right: 0.9em; top: 0.9em; padding: 0.25em 0.7em; border-radius: 1em; background: rgba(0,0,0,.65); color: #fff; font-size: 0.9em; font-weight: 600; pointer-events: none; }
  .ig-arrow { position: absolute; top: 50%; transform: translateY(-50%); width: 2.5em; height: 2.5em; padding: 0; border: 0; border-radius: 50%; background: rgba(255,255,255,.92); font-size: 1.1em; display: grid; place-items: center; cursor: pointer; box-shadow: 0 0.2em 0.6em rgba(0,0,0,.25); color: #000; transition: background .15s, transform .15s; }
  /* Bigger invisible hit area so the arrow is easy to tap on a phone */
  .ig-arrow::before { content: ''; position: absolute; inset: -0.7em; border-radius: 50%; }
  .ig-arrow:hover { background: #fff; transform: translateY(-50%) scale(1.06); }
  .ig-arrow:focus-visible { outline: 2px solid #2f3bff; outline-offset: 2px; }
  .ig-arrow[hidden] { display: none; }
  .ig-arrow.prev { left: 0.7em; }
  .ig-arrow.next { right: 0.7em; }
  .ig-actions { position: relative; flex: none; display: flex; align-items: center; gap: 1.1em; padding: 0.9em 1.1em 0.4em; }
  .ig-pager { position: absolute; left: 50%; top: 1.55em; transform: translateX(-50%); display: flex; gap: 0.3em; }
  .ig-pager i { width: 0.5em; height: 0.5em; border-radius: 50%; background: #c7c7c7; }
  .ig-pager i.on { background: #0095f6; }
  .ig-caption { margin: 0; padding: 0.2em 1.1em; font-size: 1em; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
  .ig-caption strong { font-weight: 600; }
  .ig-reelbg { position: absolute; inset: 0; background: #000; }
  .ig-reelbg img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .ig-reels { position: relative; z-index: 2; margin: 0.4em 1.4em 0; color: #fff; font-weight: 700; font-size: 1.5em; }
  .ig-side { position: absolute; right: 1em; bottom: 9em; z-index: 2; display: grid; gap: 1.5em; justify-items: center; color: #fff; }
  .ig-reelinfo { position: relative; z-index: 2; padding: 0 5em 1.2em 1.4em; color: #fff; background: linear-gradient(transparent, rgba(0,0,0,.55)); }
  .ig-who { margin: 0 0 0.4em; display: flex; align-items: center; gap: 0.6em; font-weight: 600; }
  .ig-who > span { width: 2.2em; height: 2.2em; border-radius: 50%; background: #fff; display: grid; place-items: center; overflow: hidden; flex: none; }
  .ig-reelcap { margin: 0; font-size: 0.95em; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .ig-nav { flex: none; height: 4.6em; display: flex; justify-content: space-around; align-items: center; padding: 0 1em 0.6em; background: var(--scr); z-index: 2; }
  .ig-me { width: 1.9em; height: 1.9em; border-radius: 50%; background: #d9d9d9; }
  .ig-home { position: absolute; left: 50%; bottom: 0.55em; transform: translateX(-50%); width: 9em; height: 0.35em; border-radius: 1em; background: var(--ink); z-index: 3; }
</style>

<script>
  // Carousel behaves like Instagram's: swipe (native scroll with snap), mouse drag, arrows and dots
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.ig-track')!;
    const n = track.children.length;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const dots = root.closest('.ig')?.querySelectorAll('[data-dots] i');
    let i = 0;
    const go = (k: number) => track.scrollTo({ left: Math.max(0, Math.min(n - 1, k)) * track.clientWidth, behavior: 'smooth' });
    const sync = () => {
      const k = Math.round(track.scrollLeft / track.clientWidth);
      if (k === i) return;
      i = k;
      count.textContent = `${i + 1}/${n}`;
      prev.hidden = i === 0;
      next.hidden = i === n - 1;
      dots?.forEach((d, j) => d.classList.toggle('on', j === i));
    };
    track.addEventListener('scroll', sync, { passive: true });
    prev.addEventListener('click', () => go(i - 1));
    next.addEventListener('click', () => go(i + 1));
    let drag: { x: number; left: number } | null = null;
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') return;
      drag = { x: e.clientX, left: track.scrollLeft };
      track.classList.add('drag');
    });
    track.addEventListener('pointermove', (e) => { if (drag) track.scrollLeft = drag.left - (e.clientX - drag.x); });
    const up = () => {
      if (!drag) return;
      const moved = track.scrollLeft - drag.left;
      const base = Math.round(drag.left / track.clientWidth);
      drag = null;
      track.classList.remove('drag');
      go(Math.abs(moved) > track.clientWidth * 0.15 ? base + Math.sign(moved) : base);
    };
    track.addEventListener('pointerup', up);
    track.addEventListener('pointerleave', up);
  });
</script>
