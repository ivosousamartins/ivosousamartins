---
// MacBook Pro: black bezel with the camera notch, space-black lid, slim base with the thumb recess.
// Sized in em off its own width, like the phone.
interface Props { img: string; alt?: string; size?: 'small' | 'big'; scroll?: number; }
const { img, alt = '', size = 'small', scroll = 0 } = Astro.props;
---
<div class={`mac ${size === 'big' ? 'big' : ''}`}>
  <div class="mb">
    <div class="mb-lid">
      <div class="mb-bezel">
        <div class="mb-notch"></div>
        <div class="mb-screen"><img src={img} alt={alt} loading="lazy" decoding="async" style={scroll ? `transform:translateY(-${scroll}%)` : undefined} /></div>
      </div>
    </div>
    <div class="mb-base"><div></div></div>
  </div>
</div>

<style is:global>
  .mb { font-size: 1cqw; }
  .mb-lid { width: 86%; margin: 0 auto; padding: 0.55em; border-radius: 1.5em 1.5em 0.4em 0.4em; background: #2b2c2e; box-shadow: inset 0 0 0 0.08em rgba(255,255,255,.25); }
  .mb-bezel { position: relative; aspect-ratio: 1.54; border-radius: 1.05em 1.05em 0.2em 0.2em; background: #000; padding: 1.15em 1.05em 1.3em; }
  .mb-notch { position: absolute; left: 50%; top: 0; transform: translateX(-50%); width: 8%; height: 1.15em; border-radius: 0 0 0.6em 0.6em; background: #000; z-index: 2; }
  .mb-screen { position: relative; width: 100%; height: 100%; overflow: hidden; border-radius: 0.2em; background: #fff; }
  .mb-screen img { width: 100%; display: block; }
  .mb-base { position: relative; height: 1.5em; margin-top: -0.1em; border-radius: 0.2em 0.2em 1.6em 1.6em / 0.2em 0.2em 1.2em 1.2em; background: linear-gradient(180deg, #3a3b3e, #1f2022); box-shadow: 0 1.6em 3em rgba(0,0,0,.25); }
  .mb-base > div { position: absolute; left: 50%; top: 0; transform: translateX(-50%); width: 15%; height: 0.55em; border-radius: 0 0 0.8em 0.8em; background: rgba(0,0,0,.18); }
</style>
