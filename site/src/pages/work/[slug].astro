---
import Base from '../../layouts/Base.astro';
import IgPhone from '../../components/IgPhone.astro';
import MacBook from '../../components/MacBook.astro';
import { projects, casePages, KIND_LABEL } from '../../data/projects';
import { SITE } from '../../data/site';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project = projects.find((p) => p.slug === slug)!;
const page = casePages[slug!];
const fact = (k: string) => page.facts.find(([key]) => key === k)?.[1];
const client = fact('Client') ?? fact('Clients') ?? project.title;

// Search snippet: the one-line summary, then the brief, cut on a word near 155 characters
const full = `${page.line} ${page.brief[0] ?? ''}`.trim();
const description = full.length > 158 ? full.slice(0, full.lastIndexOf(' ', 155)) + '…' : full;
const genre = project.genre ?? KIND_LABEL[project.kind];
const title = `${project.title}: ${genre.toLowerCase()} by Ivo Sousa Martins`;
const path = `/work/${slug}/`;

const schema = [
  {
    '@type': 'CreativeWork',
    '@id': `${SITE}${path}#work`,
    name: project.title,
    headline: page.line,
    description: page.brief.join(' '),
    url: SITE + path,
    image: SITE + page.hero,
    dateCreated: project.year.slice(0, 4),
    genre,
    creator: { '@id': `${SITE}/#ivo` },
    sourceOrganization: { '@type': 'Organization', name: client },
    keywords: project.meta.replaceAll(' · ', ', '),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'All work', item: `${SITE}/work/` },
      { '@type': 'ListItem', position: 3, name: project.title, item: SITE + path },
    ],
  },
];
---
<Base title={title} description={description} path={path} image={page.hero} schema={schema} back={{ href: '/work/', label: 'All work' }}>
  {page.parts.map((part) =>
    'html' in part ? <Fragment set:html={part.html} />
    : 'phone' in part ? <IgPhone {...(part.phone as any)} />
    : <MacBook {...(part.mac as any)} />
  )}
</Base>
