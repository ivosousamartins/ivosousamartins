---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found · Ivo Sousa Martins" description="This page does not exist." path="/404/" back={{ href: "/", label: "Home" }} alternates={false}>
  <section class="wrap nf">
    <h1>Lost <span class="serif">the signal.</span></h1>
    <p>This page does not exist, or moved when the site was rebuilt.</p>
    <a class="btn" href="/work/">See all work</a>
  </section>
</Base>

<style>
  .nf { padding-top: 80px; padding-bottom: 160px; }
  h1 { margin: 0; font-size: clamp(48px, 8vw, 120px); line-height: .92; letter-spacing: -0.06em; font-weight: 600; }
  p { font-size: 19px; margin: 20px 0 28px; }
</style>
