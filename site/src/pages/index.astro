---
import Base from '../layouts/Base.astro';
import { projects, count } from '../data/projects';
import { SITE, EMAIL, PHONE, person, faq } from '../data/site';
import dims from '../data/images.json';

const I = (id: string) => `/img/${id}.webp`;
const size = (id: string) => (dims as Record<string, number[]>)[id] ?? [1, 1];

const featured = projects.filter((p) => p.featured);
const stage = featured.map((p, k) => ({ ...p, n: String(k + 1).padStart(2, '0') }));
const first = stage[0];

const logos: [string, number, string][] = [
  ['606f603c32264f67da6b44e137634146', 28, 'Lidl'], ['84a6d615cbf456961a7e351cfa5011cc', 21, 'L’Oréal'], ['ac10359fca8a21d438c3a07c0e608b6f', 35, 'Nestlé'],
  ['72d7239e3750f513f9fa1b1e1b2bfc61', 36, 'Reckitt'], ['c32cefcc5df1363e5bc74ffa6b2739ba', 31, 'Galp'], ['75551b97ecfe9802b167ccfc1c4b74fd', 37, 'NOS'],
  ['1985d125b961212cd9777fae20c87c48', 38, 'European Commission'], ['4a6f4faf35424aee4fa6b9628822ed1e', 54, 'Câmara Municipal de Lisboa'],
  ['8b87d1ad467c02897cc71121042682b9', 31, 'Partido Socialista'], ['17d22806cfde75b29f9e0599dd1471f9', 40, 'Oz Energia'],
  ['79462d2466b39226ad47f900e6a1c182', 29, 'Uriage'], ['e30d005ba11809f5178a1e01f7694a3d', 23, 'Lightfoot Travel'],
  ['cd399a6ef3cf516fbea8a7a64938b3e3', 26, 'Praça Beato'], ['88f3446d7f6bc5a0cf545e1d13e6257e', 21, 'Madam Bō'],
  ['fd8dbbff2f101b066d64fb9f14e9606f', 31, 'Lisbon Street Kitchen'], ['90d7ffd1d94feac6c6ce8a805e67a9a1', 54, 'Juventude Socialista'],
  ['2bf1a028d5662bd05137dcb3c674a6ff', 40, 'Santander'], ['389f5b4e0447b383c8706355c008e319', 21, 'Lufthansa'],
];

const photos: [string, string][] = [
  ['b7f78085ff706985d5ef6acd3881ca21', 'Man walking past a red wall'], ['634370c6cc9daf91de90b83939ff3c41', 'Dome against a blue sky'],
  ['c1e10c356ccb94fdd5c81523cdc0f2b3', 'London street with a red bus'], ['19589d0e313367bdd295631a34f311d3', 'Alpine valley'],
  ['58983ee4e56e05c648ff5c5de0d8176a', 'Cow in an alpine meadow'], ['11da7d214d7e8b8d575f280529392963', 'Tower Bridge'],
  ['ee4fd9245dca0a897ae705f9b5db6985', 'Sunset on mountain peaks'], ['c402b54575e123b601edb2e7c41927c3', 'Shopfront at night'],
  ['fbd30759e14e0098dd4f7c52121bb71f', 'Alpine village'], ['949d9bc5b037d22ee99595fcae7e10c7', 'Figure in a dark arcade'],
  ['0122e540768e551e792cdbd23af3ae44', 'Pine forest'], ['3e967aa58df6615d4f1c024772485770', 'Mountain in the clouds'],
];

const facts = [
  { n: 20, suffix: '+', label: 'years in brand, design and content' },
  { n: 3, suffix: '', label: 'national election campaigns' },
  { n: 24, suffix: '', label: 'documentary episodes directed' },
  { n: 16, suffix: '+', label: 'brands and institutions' },
];

const tiles = [
  { href: '/work/?kind=design', img: '5ac3b340659d70324dba88e8c404cd56', alt: 'Praça Beato identity', name: 'Brand & design', note: `${count('design')} projects` },
  { href: '/work/?kind=film', img: '788a25d5b74bf9441c72f1b0a6272417', alt: 'Citizen Diaries still', name: 'Film', note: `${count('film')} projects · 24 episodes` },
  { href: '#photography', img: 'b7f78085ff706985d5ef6acd3881ca21', alt: 'Street photograph', name: 'Photography', note: `${photos.length} photographs` },
  { href: '/work/?kind=web', img: 'd34785b2d9e077de36b7cd37d5ab6b0a', alt: 'Lisbon city council website', name: 'Web & UX', note: `${count('web')} projects` },
];

const schema = [
  {
    '@type': 'ProfessionalService',
    '@id': `${SITE}/#service`,
    name: person.name,
    description: person.description,
    url: `${SITE}/`,
    image: `${SITE}/og-image.jpg`,
    email: EMAIL,
    telephone: PHONE.replaceAll(' ', ''),
    founder: { '@id': `${SITE}/#ivo` },
    address: { '@type': 'PostalAddress', addressLocality: 'Lisbon', addressCountry: 'PT' },
    areaServed: [{ '@type': 'Country', name: 'Portugal' }, 'Europe'],
    knowsLanguage: ['en', 'pt', 'es'],
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];

const arrow = '<svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>';
const out = '<svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 11l6-6M6.5 5H11v4.5"/></svg>';
const frameStyle = (f: { r: number; natural?: boolean }) => (f.natural ? `flex: none; aspect-ratio: ${f.r}` : `flex: ${f.r} 1 0; min-width: 0`);
---
<Base
  title="Ivo Sousa Martins · Creative director in Lisbon · Brand, photography and film"
  description={person.description}
  path="/"
  schema={schema}
>
  <section id="top" class="wrap hero">
    <p class="eyebrow">Ivo Sousa Martins · Creative director · Lisbon</p>
    <h1>Brand, film and photography <br><span class="serif">by one creative director,</span> for brands, agencies and institutions.</h1>
  </section>

  <section class="wrap disc" aria-label="Disciplines">
    {tiles.map((t) => (
      <a class="tile" href={t.href}>
        <div class="tile-img"><img src={I(t.img)} alt={t.alt} width={size(t.img)[0]} height={size(t.img)[1]} /></div>
        <p><strong>{t.name}</strong><span>{t.note}</span></p>
      </a>
    ))}
  </section>

  <section class="clients" aria-label="Brands and institutions I have worked with">
    <p class="wrap label-s">Brands and institutions I’ve worked with</p>
    <div class="marquee">
      <div class="marquee-track">
        {logos.map(([id, h, name]) => <img src={I(id)} alt={name} style={`height:${h}px`} width={Math.round(size(id)[0] * h / size(id)[1])} height={h} loading="lazy" />)}
        {logos.map(([id, h]) => <img src={I(id)} alt="" aria-hidden="true" style={`height:${h}px`} width={Math.round(size(id)[0] * h / size(id)[1])} height={h} loading="lazy" />)}
      </div>
    </div>
  </section>

  <section id="work" class="wrap work">
    <div class="work-head">
      <p class="showing">Showing
        <label><span class="sr">Type of work</span><select class="pick" data-kind><option value="all">all work</option><option value="design">brand &amp; design</option><option value="film">film</option><option value="web">web &amp; UX</option></select></label>
        for
        <label><span class="sr">Who it was for</span><select class="pick" data-aud><option value="all">everyone</option><option value="brands">brands</option><option value="institutions">institutions</option></select></label>
      </p>
      <a href="/work/" class="btn">See all {projects.length} projects <Fragment set:html={arrow} /></a>
    </div>
    <div class="stage" data-stage>
      <div>
        <p class="stage-n" data-n>{first.n}</p>
        <h2 class="stage-title" data-title>{first.title}</h2>
        <p class="stage-meta" data-meta>{first.meta}</p>
        <p class="stage-line" data-line>{first.line}</p>
        <a href={`/work/${first.slug}/`} class="btn" data-href>Open case study <Fragment set:html={arrow} /></a>
      </div>
      <div class="pic" data-pic>
        {first.frames.map((f) => <div style={frameStyle(f)}><img src={f.img} alt={first.title} /></div>)}
      </div>
    </div>
    <p class="stage-empty" data-empty hidden>Nothing featured for that mix. <a href="/work/">See all work</a>.</p>
    <div class="thumbs" aria-label="Featured projects" data-thumbs>
      {stage.map((p, k) => (
        <button type="button" class="th" data-go={k} aria-label={p.title} aria-pressed={k === 0 ? 'true' : 'false'}>
          <span>{p.frames.map((f) => <img src={f.img} alt="" style={`flex: ${f.r} 1 0`} loading="lazy" />)}</span>
        </button>
      ))}
    </div>
  </section>

  <section id="photography" class="photo">
    <div class="wrap photo-head">
      <div>
        <h2 class="h-xl">Behind <span class="serif">the lens</span></h2>
        <p class="photo-sub">Personal travel photography, free to use on <a href="https://unsplash.com/@ivosouzamartins" target="_blank" rel="noopener">Unsplash <Fragment set:html={out} /></a> and <a href="https://www.pexels.com/@ivosousamartins/" target="_blank" rel="noopener">Pexels <Fragment set:html={out} /></a></p>
      </div>
      <div class="photo-nav">
        <span data-photo-index>01 / {String(photos.length).padStart(2, '0')}</span>
        <button type="button" class="round" aria-label="Previous photograph" data-photo-prev><svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 8H3M7 4L3 8l4 4"/></svg></button>
        <button type="button" class="round" aria-label="Next photograph" data-photo-next><Fragment set:html={arrow} /></button>
      </div>
    </div>
    <div class="strip photos" data-strip>
      {photos.map(([id, alt]) => <img src={I(id)} alt={alt} width={size(id)[0]} height={size(id)[1]} loading="lazy" decoding="async" />)}
    </div>
  </section>

  <section id="about" class="wrap about-s">
    <div class="about">
      <img src={I('cdd2352058f608d8b9069b70a09e0640')} alt="Portrait of Ivo Sousa Martins" width={size('cdd2352058f608d8b9069b70a09e0640')[0]} height={size('cdd2352058f608d8b9069b70a09e0640')[1]} loading="lazy" />
      <div>
        <p class="label">About</p>
        <h2 class="h-l">Helicopter view. <span class="serif">Hands on the work.</span></h2>
        <p class="about-text">Twenty-odd years across brand strategy, design, photography and film, for luxury travel, food, energy, banks, city councils and national political campaigns. Based in Lisbon, working across Portugal and abroad.</p>
        <a href="#contact" class="link">Work with me <Fragment set:html={arrow} /></a>
      </div>
    </div>
    <div class="facts-big" data-facts>
      {facts.map((f) => <div><p data-count={f.n} data-suffix={f.suffix}>{f.n}{f.suffix}</p><span>{f.label}</span></div>)}
    </div>
  </section>

  <section class="wrap dd">
    <h2 class="h-l">What I do, <span class="serif">and what I don’t.</span></h2>
    <div class="dodont">
      <ul>
        <li><mark>Brand identities and campaigns</mark>, from the idea to the billboard.</li>
        <li><mark>Films and series</mark>, from script to final cut.</li>
        <li><mark>Short form for social</mark> that people actually watch.</li>
        <li><mark>Websites</mark> that are clear and built to convert.</li>
      </ul>
      <ul class="dont">
        <li><s>A logo by tomorrow morning.</s></li>
        <li><s>Templates dressed up as strategy.</s></li>
        <li><s>Content for the sake of content.</s></li>
        <li><s>Work I wouldn’t put my name on.</s></li>
      </ul>
    </div>
  </section>

  <section class="wrap faq" aria-labelledby="faq-title">
    <h2 class="h-l" id="faq-title">Good to <span class="serif">know.</span></h2>
    <div class="faq-list">
      {faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section id="contact" class="wrap contact">
    <div class="lead">
      <div>
        <h2 class="h-xxl">Got a project? <br><span class="serif">Tell me about it.</span></h2>
        <p class="lead-text">I reply within two working days. <br>Or write directly to <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.</p>
      </div>
      <form class="form" data-form action="/api/contact" method="post">
        <label>Name<input class="fld" type="text" name="name" autocomplete="name" required /></label>
        <label>Email<input class="fld" type="email" name="email" autocomplete="email" required /></label>
        <label>Company or agency<input class="fld" type="text" name="company" autocomplete="organization" /></label>
        <label>What do you need?<select class="fld" name="need"><option>Brand or campaign</option><option>Film or content</option><option>Website</option><option>Photography</option></select></label>
        <label>A few lines about it<textarea class="fld" name="message" rows="4" required></textarea></label>
        <label class="hp" aria-hidden="true">Leave this empty<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        <button type="submit" class="btn btn-lime">Send</button>
        <p class="form-msg" data-form-msg role="status"></p>
      </form>
    </div>
  </section>
</Base>

<script is:inline type="application/json" id="stage-data" set:html={JSON.stringify(stage.map(({ slug, title, meta, line, kind, aud, frames, n }) => ({ slug, title, meta, line, kind, aud, frames, n })))}></script>
<script>
  type Frame = { img: string; r: number; natural?: boolean };
  type Item = { slug: string; title: string; meta: string; line: string; kind: string; aud: string; frames: Frame[]; n: string };
  const ALL: Item[] = JSON.parse(document.getElementById('stage-data')!.textContent!);
  const $ = <T extends Element>(s: string) => document.querySelector<T>(s)!;

  // Featured work: the selects filter the list, the thumbnails pick the project shown in the stage
  const kindSel = $<HTMLSelectElement>('[data-kind]');
  const audSel = $<HTMLSelectElement>('[data-aud]');
  const stage = $<HTMLElement>('[data-stage]');
  const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-go]'));
  const empty = $<HTMLElement>('[data-empty]');
  let list = ALL.slice();
  let cur = 0;
  const frameStyle = (f: Frame) => (f.natural ? `flex: none; aspect-ratio: ${f.r}` : `flex: ${f.r} 1 0; min-width: 0`);
  function show(k: number) {
    cur = k;
    const p = list[k];
    if (!p) return;
    $('[data-n]').textContent = String(k + 1).padStart(2, '0');
    $('[data-title]').textContent = p.title;
    $('[data-meta]').textContent = p.meta;
    $('[data-line]').textContent = p.line;
    $<HTMLAnchorElement>('[data-href]').href = `/work/${p.slug}/`;
    const pic = $('[data-pic]');
    pic.replaceChildren(...p.frames.map((f) => {
      const box = document.createElement('div');
      box.setAttribute('style', frameStyle(f));
      const img = document.createElement('img');
      img.src = f.img; img.alt = p.title;
      box.append(img);
      return box;
    }));
    thumbs.forEach((t) => t.setAttribute('aria-pressed', String(list[k] && ALL[Number(t.dataset.go)].slug === list[k].slug)));
  }
  function filter() {
    const kind = kindSel.value, aud = audSel.value;
    list = ALL.filter((p) => (kind === 'all' || p.kind === kind) && (aud === 'all' || p.aud === aud));
    thumbs.forEach((t) => { t.hidden = !list.some((p) => p.slug === ALL[Number(t.dataset.go)].slug); });
    stage.hidden = list.length === 0;
    empty.hidden = list.length > 0;
    show(0);
  }
  kindSel.addEventListener('change', filter);
  audSel.addEventListener('change', filter);
  thumbs.forEach((t) => t.addEventListener('click', () => show(list.findIndex((p) => p.slug === ALL[Number(t.dataset.go)].slug))));

  // Photo strip: arrows step one photo, the counter follows the scroll
  const strip = $<HTMLElement>('[data-strip]');
  const idx = $<HTMLElement>('[data-photo-index]');
  const total = strip.children.length;
  const step = (dir: number) => {
    const first = strip.querySelector('img');
    strip.scrollBy({ left: dir * (first ? first.getBoundingClientRect().width + 12 : 400), behavior: 'smooth' });
  };
  $('[data-photo-prev]').addEventListener('click', () => step(-1));
  $('[data-photo-next]').addEventListener('click', () => step(1));
  strip.addEventListener('scroll', () => {
    const max = strip.scrollWidth - strip.clientWidth;
    const n = max > 0 ? Math.round((strip.scrollLeft / max) * (total - 1)) + 1 : 1;
    idx.textContent = `${String(n).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
  }, { passive: true });

  // Counters run every time the numbers come into view
  const nums = Array.from(document.querySelectorAll<HTMLElement>('[data-count]'));
  let raf = 0;
  new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      cancelAnimationFrame(raf);
      if (!e.isIntersecting || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const start = performance.now();
      const tick = (t: number) => {
        const q = Math.min(1, (t - start) / 1400), ease = 1 - Math.pow(1 - q, 3);
        nums.forEach((el) => { el.textContent = `${Math.round(Number(el.dataset.count) * ease)}${el.dataset.suffix}`; });
        if (q < 1) raf = requestAnimationFrame(tick);
      };
      raf = requestAnimationFrame(tick);
    });
  }, { threshold: 0.4 }).observe($('[data-facts]'));

  // Contact form: send through the site; if that is not available, open an email with the same text
  const form = $<HTMLFormElement>('[data-form]');
  const msg = $<HTMLElement>('[data-form-msg]');
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
    const btn = form.querySelector('button')!;
    btn.disabled = true;
    msg.textContent = 'Sending…';
    try {
      const res = await fetch('/api/contact', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      msg.textContent = 'Thank you. I’ll reply within two working days.';
      (window as any).gtag?.('event', 'generate_lead', { method: 'form', need: data.need });
    } catch {
      const body = `${data.message}\n\n${data.name}${data.company ? `, ${data.company}` : ''}\n${data.email}`;
      location.href = `mailto:ivo@helloivo.pt?subject=${encodeURIComponent(`Project: ${data.need}`)}&body=${encodeURIComponent(body)}`;
      msg.textContent = 'Opening your email app to send it.';
    } finally {
      btn.disabled = false;
    }
  });
</script>

<style>
  .hero { padding-top: 72px; padding-bottom: 56px; }
  .eyebrow { margin: 0 0 18px; font-size: 14px; color: var(--muted); }
  .hero h1 { margin: 0; max-width: 980px; font-size: clamp(36px, 5.2vw, 72px); line-height: 1.02; letter-spacing: -0.045em; font-weight: 600; }
  .disc { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 16px; }
  .tile { display: block; text-decoration: none; }
  .tile-img { overflow: hidden; border-radius: 14px; aspect-ratio: 3 / 4; background: #ddd; }
  .tile img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .8s cubic-bezier(.2,.7,.1,1); }
  .tile:hover img { transform: scale(1.04); }
  .tile p { margin: 12px 0 0; display: flex; justify-content: space-between; gap: 8px; font-size: 15px; }
  .tile strong { font-weight: 600; }
  .tile span { color: var(--muted); text-align: right; }
  .clients { padding-top: 110px; }
  .label-s { margin: 0 auto 26px; font-size: 14px; color: var(--muted); }
  .marquee { overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .marquee-track { display: flex; align-items: center; gap: 72px; width: max-content; animation: logos 60s linear infinite; }
  .marquee:hover .marquee-track { animation-play-state: paused; }
  /* Each logo has its own height so all carry the same visual weight */
  .marquee img { width: auto; filter: brightness(0); opacity: .55; transition: opacity .3s, filter .3s; }
  /* Filter chain that turns the black logo into the identity blue */
  .marquee img:hover { opacity: 1; filter: brightness(0) invert(11%) sepia(82%) saturate(3731%) hue-rotate(238deg) brightness(169%) contrast(115%); }
  @keyframes logos { to { transform: translateX(calc(-50% - 36px)); } }
  .work { padding-top: 120px; }
  .work-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 14px; margin-bottom: 32px; border-top: 1px solid var(--line); padding-top: 24px; }
  .showing { margin: 0; font-size: clamp(24px, 2.6vw, 36px); letter-spacing: -0.035em; line-height: 1.5; }
  .pick { appearance: none; -webkit-appearance: none; border: 0; border-radius: 999px; background-color: var(--soft); padding: 2px 34px 2px 14px; font: inherit; letter-spacing: inherit; color: inherit; cursor: pointer; background-image: linear-gradient(45deg, transparent 50%, #121212 50%), linear-gradient(135deg, #121212 50%, transparent 50%); background-position: calc(100% - 18px) 55%, calc(100% - 12px) 55%; background-size: 6px 6px, 6px 6px; background-repeat: no-repeat; }
  .pick:hover { background-color: #d9d9d3; }
  .stage { display: grid; grid-template-columns: minmax(0,0.75fr) minmax(0,1.25fr); gap: 48px; align-items: end; }
  .stage[hidden] { display: none; }
  .stage-n { margin: 0; font-family: var(--serif); font-style: italic; font-size: clamp(60px, 8vw, 120px); line-height: .9; color: #c9c9c3; }
  .stage-title { margin: 10px 0; font-size: clamp(40px, 5vw, 78px); line-height: .98; letter-spacing: -0.05em; font-weight: 600; }
  .stage-meta { margin: 0 0 16px; color: var(--muted); }
  .stage-line { margin: 0 0 26px; font-size: 18px; line-height: 1.45; max-width: 440px; }
  .stage-empty { font-size: 18px; color: var(--muted); }
  .pic { width: 100%; aspect-ratio: 16 / 9; display: flex; justify-content: center; gap: 10px; overflow: hidden; }
  .pic > div { height: 100%; border-radius: 12px; overflow: hidden; background: var(--soft); }
  .pic img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .thumbs { display: flex; gap: 10px; overflow-x: auto; scrollbar-width: none; padding: 22px 2px 4px; margin-top: 40px; border-top: 1px solid var(--line); }
  .thumbs::-webkit-scrollbar { display: none; }
  .th { flex: none; border: 0; padding: 0; background: transparent; cursor: pointer; border-radius: 6px; opacity: .45; transition: opacity .3s, transform .3s; outline-offset: 3px; }
  .th[hidden] { display: none; }
  .th:hover { transform: translateY(-3px); opacity: .8; }
